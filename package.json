{
  "name": "form-kit",
  "version": "0.1.0",
  "description": "Componentes de formularios compartidos para las aplicaciones institucionales.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css", "README.md", "AGENTS.md"],
  "scripts": {
    "dev": "pnpm --dir playground dev",
    "build": "esbuild src/index.js --bundle --format=esm --platform=browser --loader:.js=jsx --jsx=automatic --external:react --external:react/jsx-runtime --external:react-dom --external:react-hook-form --external:react-datepicker --external:react-select --external:date-fns --external:@heroicons/react/24/outline --outdir=dist",
    "start": "pnpm --dir playground start",
    "prepare": "pnpm build"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2.0.0",
    "date-fns": ">=2.0.0",
    "react": ">=18.0.0",
    "react-datepicker": ">=8.0.0",
    "react-dom": ">=18.0.0",
    "react-hook-form": ">=7.0.0",
    "react-select": ">=5.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "packageManager": "pnpm@8.15.4",
  "engines": {
    "node": ">=22.23.1",
    "pnpm": ">=8.15.4"
  }
}
